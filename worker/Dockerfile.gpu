# ============================================================
# DoclingGPU - GPU Worker Dockerfile
# Based on official Docling GPU image with CUDA support
# Used by IBM Code Engine Serverless Fleet GPU workers
# ============================================================

# Use official Docling GPU image as base (includes CUDA + Docling)
FROM quay.io/docling-project/docling-serve:latest AS base

# Build arguments
ARG BUILD_DATE
ARG VERSION=1.0.0

# Labels
LABEL org.opencontainers.image.title="DoclingGPU Worker (GPU)" \
      org.opencontainers.image.description="Docling GPU worker for IBM Code Engine Serverless Fleet" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}"

# Environment for GPU processing
ENV DOCLING_DEVICE=cuda \
    DOCLING_NUM_THREADS=4 \
    PYTHONUNBUFFERED=1 \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    OMP_NUM_THREADS=4

# Install additional utilities
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Copy worker script
COPY --chown=docling:docling worker.py /app/worker.py
COPY --chown=docling:docling entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

USER docling
WORKDIR /app

# The worker reads from /input and writes to /output
# These are mounted from COS via Code Engine fleet data stores
VOLUME ["/input", "/output"]

ENTRYPOINT ["/app/entrypoint.sh"]